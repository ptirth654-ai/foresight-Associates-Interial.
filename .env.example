# Foresight Associates — Server Environment Configuration
# Copy this file to .env and replace placeholder values with your verified credentials.

# Server Port
PORT=3000

# Environment (development, production)
NODE_ENV=development

# Allowed CORS Origins (comma-separated if multiple)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Studio Notification Email (Where enquiries should be dispatched)
STUDIO_RECIPIENT_EMAIL=inquiries@foresightassociates.in

# SMTP Email Dispatch Configuration (Optional - Leave blank to use file-based enquiry logging)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME="Foresight Associates Website"
SMTP_FROM_EMAIL=no-reply@foresightassociates.in

